VITE_APP_NAME=RobinPulse

COINGECKO_API_KEY=
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3

DEXSCREENER_API_BASE_URL=https://api.dexscreener.com

GECKOTERMINAL_API_BASE_URL=https://api.geckoterminal.com/api/v2
GECKOTERMINAL_ROBINHOOD_NETWORK_ID=

# Server-only. Powers Robinhood Mainnet Trending + Hot Searches via GMGN's
# OpenAPI. Never prefix with VITE_ — see docs/GMGN_SETUP.md.
GMGN_API_KEY=

# Server-only. Powers /swap (0x Swap API v2). Never prefix with VITE_, never
# expose to the browser — see docs/0X_SWAP_SETUP.md.
ZEROX_API_KEY=

# Server-only. The ONLY source of the RobinPulse platform-fee recipient —
# must be a valid EVM address before live swapping is enabled. Never a
# sample/placeholder address, never a developer wallet. A multisig is
# strongly recommended — see docs/TREASURY_SETUP.md.
ROBINPULSE_FEE_RECIPIENT=

# Fee model — see docs/SWAP_FEE_MODEL.md. Defaults match the spec exactly;
# ROBINPULSE_SWAP_FEE_BPS is clamped to a hardcoded 100bps ceiling regardless
# of this value.
ROBINPULSE_SWAP_FEE_BPS=10
ROBINPULSE_MAX_SWAP_FEE_BPS=30

ROBINHOOD_CHAIN_ID=
ROBINHOOD_CHAIN_NAME=
ROBINHOOD_RPC_URL=
ROBINHOOD_EXPLORER_URL=
ROBINHOOD_NATIVE_CURRENCY_NAME=
ROBINHOOD_NATIVE_CURRENCY_SYMBOL=

# Client-exposed copies of the same chain facts above, for wallet-connect UI.
# These are public blockchain facts (not secrets) and are safe in VITE_ vars.
VITE_ROBINHOOD_CHAIN_ID=
VITE_ROBINHOOD_CHAIN_NAME=
VITE_ROBINHOOD_RPC_URL=
VITE_ROBINHOOD_EXPLORER_URL=
VITE_ROBINHOOD_NATIVE_CURRENCY_NAME=
VITE_ROBINHOOD_NATIVE_CURRENCY_SYMBOL=

# Required for wallet connect. Get this from the Privy Dashboard
# (dashboard.privy.io -> create app -> App ID). Privy provides its own
# WalletConnect relay by default, so VITE_WALLETCONNECT_PROJECT_ID below is
# optional. See docs/WALLET_SETUP.md.
VITE_PRIVY_APP_ID=

# Optional. Only needed to point Privy at a self-hosted/custom WalletConnect
# Cloud project instead of Privy's own default relay.
VITE_WALLETCONNECT_PROJECT_ID=

# Set to "true" once Privy wallet connect + /swap are ready to go live
# for real users. See docs/WALLET_SETUP.md and docs/0X_SWAP_SETUP.md.
VITE_WALLET_ENABLED=

VITE_PROJECT_WEBSITE_URL=
VITE_PROJECT_DOCS_URL=
VITE_PROJECT_WHITEPAPER_URL=

VITE_X_URL=
VITE_DISCORD_URL=
VITE_TELEGRAM_URL=
VITE_GITHUB_URL=
VITE_MEDIUM_URL=

VITE_CONTACT_EMAIL=
VITE_SUPPORT_URL=

# Exposed to the browser so the client knows which chain qualifies as
# Robinhood Mainnet. Never place private API keys in a VITE_ variable.
VITE_ROBINHOOD_DEXSCREENER_CHAIN_ID=

# Agent Hub — pre-TGE AI-agent collectible/farming preview. See
# docs/AGENT_HUB_OVERVIEW.md. VITE_AGENT_HUB_ENABLED is the hard
# kill-switch: false means the route and nav entry do not exist at all.
VITE_AGENT_HUB_ENABLED=true
# Dev-only "Add Preview Agent" control — never available in a production
# build regardless of this value. See docs/AGENT_HUB_OVERVIEW.md.
VITE_ENABLE_AGENT_HUB_PREVIEW=false

# Agent Hub reuses VITE_ROBINHOOD_CHAIN_ID/_RPC_URL/_EXPLORER_URL and
# VITE_WALLETCONNECT_PROJECT_ID above — it targets the same chain as the
# rest of the app. Only its own contract addresses are new. Never a
# sample/placeholder address — see docs/AGENT_CONTRACT_INTEGRATION.md.
VITE_AGENT_COLLECTION_CONTRACT=
VITE_AGENT_FARMING_CONTRACT=
VITE_PULSE_TOKEN_CONTRACT=
VITE_PULSE_CLAIM_CONTRACT=

# Cross-chain Bridge — see docs/BRIDGE_SETUP.md.
#
# Server-only. The ONLY source of the RobinPulse bridge fee treasury. Must
# be a valid EVM address before any bridge route is offered. Never a
# sample/placeholder address, never a developer wallet. A multisig is
# strongly recommended — see docs/TREASURY_SETUP.md.
ROBINPULSE_TREASURY_ADDRESS=

# Server-only. Bridge aggregator credentials. Never prefix with VITE_,
# never expose to the browser — see docs/BRIDGE_SETUP.md.
LIFI_INTEGRATOR=robinpulse
LIFI_API_KEY=
RELAY_API_KEY=
ACROSS_API_KEY=
ACROSS_INTEGRATOR_ID=
GASZIP_API_KEY=

# Per-provider kill switches. A provider is only ever queried when its flag
# is "true" AND its credentials above are present AND (for Relay/Across) its
# app-fee mechanism is confirmed below.
LIFI_ENABLED=true
RELAY_ENABLED=true
ACROSS_ENABLED=true
# Gas.zip is a native-token gas-refuel service, not a general ERC-20
# bridge, and has no documented platform-fee mechanism. Kept off until an
# officially supported integration is confirmed — see docs/BRIDGE_SETUP.md.
GASZIP_ENABLED=false

# Set to "true" ONLY after the provider has confirmed the RobinPulse app fee
# is configured on their side. While false, that provider's routes are
# excluded entirely rather than shown fee-free — RobinPulse never modifies
# provider calldata to insert a fee. See docs/BRIDGE_FEE_MODEL.md.
RELAY_APP_FEE_CONFIRMED=false
ACROSS_APP_FEE_CONFIRMED=false

# 100 bps = 1%, per spec. Clamped to a hardcoded 100 bps ceiling in
# src/lib/bridge/fee.ts regardless of this value — env can only lower it.
BRIDGE_PLATFORM_FEE_BPS=100

# Optional. JSON map of pinned, owner-verified destination contracts per
# chain: {"4663":["0x..."],"1":["0x..."]}. Empty means "trust only the
# address the provider's own API returned" (always enforced regardless).
# Never pre-fill with guessed addresses — see docs/BRIDGE_SECURITY.md.
BRIDGE_CONTRACT_ALLOWLIST=

# Set to "true" once bridge providers + treasury are ready to go live for
# real users. While false the Bridge tab renders a not-configured notice
# and the wallet stays on Robinhood Mainnet only (no multi-chain signing).
VITE_BRIDGE_ENABLED=
