; @privy-io/wagmi pins an exact viem patch version as a peer dep (e.g. 2.55.5)
; regardless of release, while this project tracks a newer viem patch (^2.55.10).
; Both are the same minor line; the pin is stricter than necessary. Without this,
; `npm install` fails with ERESOLVE both locally and on Vercel's build.
legacy-peer-deps=true
